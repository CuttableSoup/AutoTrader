{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autotrader:v1/envelope",
  "title": "Envelope",
  "description": "Wrapper for every message on every subject. The payload is validated separately against the subject's payload schema (see schemas/topics.json).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "msg_id", "ts_utc", "producer", "payload"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "msg_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "ts_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" },
    "producer": { "type": "string", "minLength": 1, "maxLength": 64 },
    "correlation_id": { "type": "string", "description": "Optional. msg_id of the message that caused this one." },
    "payload": { "type": "object" }
  }
}
