{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autotrader:v1/signals.candidate",
  "title": "signals.candidate payload",
  "description": "A candidate entry produced by the strategy engine. thesis_facts are neutral, numeric statements only. No adjectives: the validator must not be nudged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["symbol", "side", "signal_type", "strategy_version", "event_id", "session_date", "ear_pct", "vol_ratio", "mom_pct", "entry_px_ref_cents", "atr20_cents", "adv20_shares", "spy_above_trend", "thesis_facts", "data_as_of_utc"],
  "properties": {
    "symbol": { "type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$" },
    "side": { "type": "string", "enum": ["BUY"] },
    "signal_type": { "type": "string", "enum": ["EARNINGS_MOMENTUM_V1", "MOMENTUM_SLEEVE_V2"] },
    "strategy_version": { "type": "string" },
    "event_id": { "type": "string" },
    "session_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Session whose close produced this signal." },
    "ear_pct": { "type": "number", "description": "2-day abnormal announcement return, percent." },
    "vol_ratio": { "type": "number", "minimum": 0, "description": "Announcement-day volume / 20-day ADV." },
    "mom_pct": { "type": "number", "minimum": 0, "maximum": 100, "description": "Percentile rank of 12-1 return within the universe (100 = best)." },
    "rsi5": { "type": ["number", "null"] },
    "revision_breadth": { "type": ["number", "null"], "description": "v1.1 only." },
    "entry_px_ref_cents": { "type": "integer", "minimum": 1 },
    "atr20_cents": { "type": "integer", "minimum": 1 },
    "adv20_shares": { "type": "integer", "minimum": 0 },
    "sector": { "type": "string" },
    "spy_above_trend": { "type": "boolean" },
    "entry_deadline_date": { "type": "string", "description": "Last session on which entry is allowed (signal + 2 trading days)." },
    "next_report_date": { "type": ["string", "null"] },
    "universe_snapshot_id": { "type": "string" },
    "thesis_facts": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 12 },
    "data_as_of_utc": { "type": "string" }
  }
}
