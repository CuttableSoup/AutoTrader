{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autotrader:v1/market.data",
  "title": "market.data payload",
  "description": "Daily bar (subject market.data.bar.<SYMBOL> or market.data.bar_tr.<SYMBOL>), NBBO quote (subject market.data.quote.<SYMBOL>), or TSMOM shortable pre-flight (subject market.data.shortable.<SYMBOL>). Prices are integer cents.",
  "type": "object",
  "required": ["kind", "symbol", "source", "data_ts_utc"],
  "properties": {
    "kind": { "type": "string", "enum": ["bar", "quote", "shortable"] },
    "symbol": { "type": "string", "pattern": "^[A-Z][A-Z0-9.\\-]{0,9}$" },
    "source": { "type": "string", "enum": ["alpaca", "sharadar", "synthetic", "replay"] },
    "data_ts_utc": { "type": "string", "description": "When the vendor says the data was observed. Staleness is measured from this, not from ts_utc." },
    "session_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Bars only. NY trading session the bar belongs to." },
    "open_cents": { "type": "integer", "minimum": 0 },
    "high_cents": { "type": "integer", "minimum": 0 },
    "low_cents": { "type": "integer", "minimum": 0 },
    "close_cents": { "type": "integer", "minimum": 0 },
    "volume": { "type": "integer", "minimum": 0 },
    "adjusted": { "type": "boolean", "description": "Bars only. True if split-adjusted." },
    "split_factor": { "type": "number", "description": "Bars only. Cumulative split factor applied to this bar if adjusted." },
    "bid_cents": { "type": "integer", "minimum": 0 },
    "ask_cents": { "type": "integer", "minimum": 0 },
    "bid_size": { "type": "integer", "minimum": 0 },
    "ask_size": { "type": "integer", "minimum": 0 },
    "halted": { "type": "boolean" },
    "shortable": { "type": "boolean", "description": "shortable kind only: true iff Alpaca reports both shortable and easy_to_borrow." }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "bar" } } },
      "then": { "required": ["session_date", "open_cents", "high_cents", "low_cents", "close_cents", "volume"] }
    },
    {
      "if": { "properties": { "kind": { "const": "quote" } } },
      "then": { "required": ["bid_cents", "ask_cents", "bid_size", "ask_size"] }
    },
    {
      "if": { "properties": { "kind": { "const": "shortable" } } },
      "then": { "required": ["shortable"] }
    }
  ]
}
