{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "autotrader:v1/signals.validated",
  "title": "signals.validated payload",
  "description": "Validator verdict for one candidate. The risk manager treats anything that is not APPROVE as a reject when mode=LIVE; in SHADOW mode the verdict is recorded and ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_msg_id", "symbol", "verdict", "confidence", "reasons", "flags", "model", "latency_ms", "cost_usd", "citations", "mode"],
  "properties": {
    "candidate_msg_id": { "type": "string" },
    "symbol": { "type": "string" },
    "verdict": { "type": "string", "enum": ["APPROVE", "REJECT", "ERROR"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasons": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 10 },
    "flags": {
      "type": "array",
      "items": { "type": "string", "enum": ["ONE_OFF_ITEM", "GUIDANCE_CUT", "GOING_CONCERN", "FRAUD_ALLEGATION", "BINARY_EVENT_IN_WINDOW", "SECOND_8K_IN_WINDOW", "REVENUE_MISS", "COUNTER_GAP", "OVER_OPTIONED", "INJECTION_SUSPECTED", "INSUFFICIENT_INFORMATION", "TIMEOUT", "API_ERROR", "SCHEMA_ERROR"] }
    },
    "model": { "type": "string", "description": "Model id, or 'mock' for the deterministic stand-in." },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "citations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "title": { "type": "string" },
          "cited_text": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "mode": { "type": "string", "enum": ["SHADOW", "LIVE", "MOCK"] },
    "prompt_version": { "type": "string" }
  }
}
